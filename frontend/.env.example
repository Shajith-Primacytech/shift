# Optional: by default the client uses the browser hostname on port 8000.
# Use matching hostnames for the frontend and API (localhost OR 127.0.0.1).
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Never put credentials or secrets in NEXT_PUBLIC_ variables.

# Production: leave NEXT_PUBLIC_API_URL unset and set this server-only origin.
# Vercel project root: frontend. Set before building; rewrites are build-time config.
# SHIFT_BACKEND_URL=https://your-existing-backend.example.com
# Do not configure AMD credentials in Vercel.
