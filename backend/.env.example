SHIFT_ENVIRONMENT=development
SHIFT_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SHIFT_DATABASE_PATH=data/shift.sqlite3
SHIFT_SEED_SYNTHETIC=true
SHIFT_SESSION_HOURS=12

# AMD inference adapter; backend only. Never use NEXT_PUBLIC_ for credentials.
AMD_API_KEY=
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_MODEL=DeepSeek-V4-Flash
# Used by authenticated troubleshooting only; no startup inference calls.
# Seconds: an overall deadline includes requests and any retry delays.
AMD_CONNECT_TIMEOUT=5
AMD_READ_TIMEOUT=45
AMD_OVERALL_TIMEOUT=55
# Additional attempts, 0–2. Only connect/pool failures and HTTP 429 retry.
AMD_MAX_RETRIES=1
